# Server Port Configuration
PORT=5000

# MongoDB Connection (MERN Stack Data Storage)
# Replace with your actual MongoDB Atlas connection string or local MongoDB URI.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/parentpal?retryWrites=true&w=majority

# Pinecone Database Credentials (Vector RAG Search)
# Get this from your Pinecone Console: https://console.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=parentpal

# Google Gemini API Key (AI generation & text embedding)
# Get this from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
